# =============================================================================
# NOVA ANGLERS ALLIANCE — Environment variables (Stage 6.5)
# Copy to .env and fill values before `prisma db push` + `prisma seed`
# =============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
# Local dev (embedded postgres on 5433) or Supabase pooler:
#   postgresql://nova_app:password@127.0.0.1:5433/nova
#   postgresql://nova_app:password@aws-0-region.pooler.supabase.com:5432/postgres?connection_limit=10
DATABASE_URL="postgresql://nova_app:nova_app_local@127.0.0.1:5433/nova"

# --- Demo accounts (set BEFORE seed) -----------------------------------------
NOVA_ADMIN_EMAIL="admin@nova.ru"
NOVA_ADMIN_PASSWORD="pass123"
NOVA_ORGANIZER_EMAIL="org@nova.ru"
NOVA_ORGANIZER_PASSWORD="pass123"
NOVA_VIEWER_EMAIL="viewer@nova.ru"
NOVA_VIEWER_PASSWORD="pass123"
NOVA_ATHLETE_EMAIL="athlete@nova.ru"
NOVA_ATHLETE_PASSWORD="pass123"

# --- Storage (documents + payment proofs) ------------------------------------
# local = files in storage/documents/ and private-uploads/ (dev)
# supabase = Supabase Storage (private bucket)
STORAGE_DRIVER="local"
STORAGE_DIR="./storage/documents"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
NOVA_DOCUMENTS_BUCKET="documents"

# --- Payments — feature flags (Stage 6.5 ADDENDUM A) --------------------------
PAYMENT_ONLINE_ENABLED=false
PAYMENT_BANK_TRANSFER_ENABLED=true
BANK_TRANSFER_TIMEOUT_HOURS=48

# --- Payments — provider (Stage 6 §2) ----------------------------------------
# mock = dev sandbox (local checkout page, no external calls)
# cloudpayments = CloudPayments REST API (prod)
PAYMENTS_DRIVER="mock"
CLOUDPAYMENTS_PUBLIC_ID=""
CLOUDPAYMENTS_API_SECRET=""
ALLOW_MOCK_PAYMENTS="1"

# --- Email (Stage 6 §1) ------------------------------------------------------
# console = dev (logs to email_log + stdout)
# resend = Resend REST API (prod)
EMAIL_DRIVER="console"
SMTP_API_KEY=""
EMAIL_FROM="NOVA Anglers Alliance <noreply@nova-anglers.ru>"

# App secret for HMAC (unsubscribe tokens, etc.)
APP_SECRET="nova-local-dev-secret-change-in-prod"

# --- Optional ---------------------------------------------------------------
# NODE_ENV=development
